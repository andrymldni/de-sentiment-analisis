# BRILink Sentiment Platform - environment template
# Copy to .env and adjust:  cp .env.example .env
# Every value below matches the docker-compose.yml default, so an empty
# override is fine unless you want to change something.

# --- application -----------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- postgres / redis -------------------------------------------------
POSTGRES_DB=brilinkdb
POSTGRES_USER=brilink
POSTGRES_PASSWORD=brilink
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379

# --- ingestion ---------------------------------------------------------
INGEST_CONNECTORS=all
INGEST_KEYWORDS=brilink,agen brilink,agen bri,laku pandai bri
INGEST_SEED_FALLBACK=true
INGEST_SEED_DOCUMENTS=2400

# --- sentiment engine ---------------------------------------------------
SENTIMENT_ENGINE_MODE=ensemble
SENTIMENT_ENABLE_TRANSFORMER=true
SENTIMENT_ENABLE_EMOTION=true
SENTIMENT_MODEL_VERSION=brilink-ensemble-v2.0.0

# --- external API keys (leave blank to disable that connector) ----------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
ANTHROPIC_API_KEY=

# --- metabase ------------------------------------------------------------
METABASE_ADMIN_EMAIL=admin@brilink.local
METABASE_ADMIN_PASSWORD=BrilinkDemo123!
METABASE_PORT=3000

# --- airflow --------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PORT=8080

# --- build flags (affect `make build` / `make up`) ------------------------
INSTALL_TORCH=true
PREFETCH_MODELS=false
