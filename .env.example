# BRILink Sentiment Platform - environment template
# Copy to .env and adjust:  cp .env.example .env
# Every value below matches the docker-compose.yml default, so an empty
# override is fine unless you want to change something.

# --- application -----------------------------------------------------
APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- postgres / redis -------------------------------------------------
POSTGRES_DB=brilinkdb
POSTGRES_USER=brilink
POSTGRES_PASSWORD=brilink
POSTGRES_PORT_HOST=5432
REDIS_PORT_HOST=6379

# --- ingestion ---------------------------------------------------------
INGEST_CONNECTORS=all
INGEST_KEYWORDS=brilink,agen brilink,agen bri,laku pandai bri
# YouTube channel ID(s) whose comments are read. Default = the official
# Bank BRI channel (@bank_bri). Use IDs, not names: fake "BANK BRI" channels exist.
INGEST_YOUTUBE_CHANNEL_IDS=UCRHFE_ooDrkEiRRJbog3EjA
# Google Play apps to read: brimo, brilink_mobile (comma separated).
INGEST_PLAYSTORE_APPS=brimo,brilink_mobile
INGEST_SEED_FALLBACK=true
INGEST_SEED_DOCUMENTS=2400

# --- sentiment engine ---------------------------------------------------
SENTIMENT_ENGINE_MODE=ensemble
SENTIMENT_ENABLE_TRANSFORMER=true
SENTIMENT_ENABLE_EMOTION=true
SENTIMENT_MODEL_VERSION=brilink-ensemble-v2.0.0

# --- LLM judge (optional second opinion for low-confidence documents) ------
# Set to true and fill DEEPSEEK_API_KEY (or ANTHROPIC_API_KEY) below.
SENTIMENT_ENABLE_LLM_JUDGE=false
# auto = use whichever key is set, DeepSeek first | deepseek | anthropic
SENTIMENT_LLM_PROVIDER=auto
# Empty = provider default (deepseek-flash / claude-haiku-4-5-20251001)
SENTIMENT_LLM_MODEL=
# Max documents sent to the LLM per scoring run (cost guard)
SENTIMENT_LLM_MAX_DOCUMENTS=300

# --- external API keys (leave blank to disable that connector) ----------
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=
TWITTER_BEARER_TOKEN=
GOOGLE_MAPS_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- metabase ------------------------------------------------------------
METABASE_ADMIN_EMAIL=admin@brilink.local
METABASE_ADMIN_PASSWORD=BrilinkDemo123!
METABASE_PORT=3000

# --- airflow --------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_PORT=8080

# --- build flags (affect `make build` / `make up`) ------------------------
INSTALL_TORCH=true
PREFETCH_MODELS=false
